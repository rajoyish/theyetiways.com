---
import BaseLayout from "./BaseLayout.astro";
import Badge from "../components/Badge.astro";
import AuthorBadge from "../components/AuthorBadge.astro";
import FormattedDate from "../components/FormattedDate.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import Prose from "../components/Prose.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import CtaBand from "../components/CtaBand.astro";
import {
  authorPath,
  getRelatedPosts,
  getTranslations,
  postOgPath,
  postPath,
  postSlug,
  resolveAuthors,
  type Post,
} from "../lib/posts";
import { youTubeWatchUrl } from "../lib/youtube";
import { SITE } from "../lib/site";
import {
  categoryLabel,
  categoryPath,
  getLangFromUrl,
  localeAlternates,
  localizePath,
  useTranslations,
} from "../lib/i18n";
import { blogPostingSchema, breadcrumbSchema } from "../lib/seo";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { data } = post;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const authors = await resolveAuthors(post);
const related = await getRelatedPosts(post, 3);

/* A story's slug is translated, so its hreflang pairs come from the
   translation group rather than from re-prefixing this page's path. */
const siblings = await getTranslations(post);
const alternates = localeAlternates((code) => {
  const sibling = siblings[code];
  return sibling ? `/blog/${postSlug(sibling)}` : undefined;
});

const site = Astro.site ?? new URL(SITE.url);
const postUrl = new URL(`${postPath(post)}/`, site);
/* A hand-picked cover wins; otherwise the story gets its generated OG card
   from `src/pages/og/[...slug].png.ts`, which is built for every post. The old
   YouTube-thumbnail fallback is gone: `maxresdefault` 404s for most Shorts, and
   a bare video frame carries no title. */
const ogImage = data.cover
  ? new URL(data.cover.src, site).href
  : new URL(postOgPath(post), site).href;
const authorMeta = authors.map((author) => ({
  name: author.data.name,
  url: new URL(`${authorPath(author.id, lang)}/`, site).href,
}));

const jsonLd = [
  blogPostingSchema(
    {
      title: data.title,
      description: data.description,
      url: postUrl,
      image: ogImage,
      datePublished: data.pubDate,
      dateModified: data.updatedDate,
      authors: authorMeta,
      section: categoryLabel(data.category, lang),
      tags: data.tags,
    },
    site,
    lang,
  ),
  breadcrumbSchema([
    { name: t.post.breadcrumbHome, url: new URL(localizePath("/", lang), site).href },
    {
      name: t.post.breadcrumbStories,
      url: new URL(`${localizePath("/blog", lang)}/`, site).href,
    },
    {
      name: categoryLabel(data.category, lang),
      url: new URL(`${categoryPath(data.category, lang)}/`, site).href,
    },
    { name: data.title, url: postUrl.href },
  ]),
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  image={ogImage}
  imageAlt={data.coverAlt || data.title}
  jsonLd={jsonLd}
  alternates={alternates}
  article={{
    publishedTime: data.pubDate,
    modifiedTime: data.updatedDate ?? data.pubDate,
    authors: authors.map((author) => author.data.name),
    section: categoryLabel(data.category, lang),
    tags: data.tags,
  }}
>
  <article>
    <div class="mx-auto max-w-3xl px-6 pt-12 sm:pt-16">
      <div class="flex flex-wrap items-center gap-2">
        <Badge variant="pill" href={categoryPath(data.category, lang)}>
          {categoryLabel(data.category, lang)}
        </Badge>
        {data.featured && <Badge variant="pink">{t.common.featured}</Badge>}
      </div>

      <h1 class="mt-5 text-display-md text-ink sm:text-display-lg">{data.title}</h1>
      <p class="mt-5 text-lg text-body-strong">{data.description}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-hairline pb-8">
        <AuthorBadge authors={authors} size={36} />
        <span class="text-muted-soft" aria-hidden="true">·</span>
        <FormattedDate date={data.pubDate} class="text-sm text-muted" />
        {
          data.updatedDate && (
            <span class="text-sm text-muted-soft">
              ({t.post.updated} <FormattedDate date={data.updatedDate} />)
            </span>
          )
        }
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-6 py-10">
      <YouTubeEmbed id={data.youtube} title={data.title} />
      <p class="mt-3 text-sm text-muted">
        <span>{t.post.watchOn} </span><a
          href={youTubeWatchUrl(data.youtube)}
          class="font-medium text-primary underline underline-offset-2"
          target="_blank"
          rel="noopener noreferrer">YouTube</a>
      </p>
    </div>

    <div class="mx-auto max-w-3xl px-6 pb-16">
      <Prose>
        <slot />
      </Prose>

      {
        data.tags.length > 0 && (
          <div class="mt-12 flex flex-wrap gap-2 border-t border-hairline pt-8">
            {data.tags.map((tag) => (
              <span class="rounded-full bg-surface-card px-3 py-1 text-[0.8125rem] text-muted">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </article>

  <RelatedPosts posts={related} />

  <div class="py-16 sm:py-24">
    <CtaBand />
  </div>
</BaseLayout>
