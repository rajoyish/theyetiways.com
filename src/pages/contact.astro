---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT, SITE, SOCIAL_CHANNELS } from "../lib/site";

const mailto = `mailto:${CONTACT.email}`;

/**
 * A blurb per channel, keyed off the labels in SOCIAL_CHANNELS so the list and
 * the copy can't drift apart. A channel without a note still renders.
 */
const CHANNEL_NOTES: Record<string, string> = {
  Facebook: "Where most of the conversation happens. Comments, replies, all of it.",
  YouTube: "The videos every story here is built around.",
  TikTok: "The short version, usually posted first.",
};

/** Reasons to write, in the order we're most likely to be useful. */
const REASONS = [
  {
    heading: "Say hello",
    text: "A story landed, or reminded you of your own afternoon. This is our favourite kind of mail.",
  },
  {
    heading: "Ask about using something",
    text: "You'd like to quote, translate, or republish a story. Tell us which one and where it's going.",
  },
  {
    heading: "Tell us we got it wrong",
    text: "A broken link, a name misspelled, a fact off. We'd rather hear it than leave it.",
  },
  {
    heading: "Privacy and terms",
    text: "Anything about what we store or how our writing may be used.",
  },
];
---

<BaseLayout
  title="Contact"
  description={`Get in touch with the Yeti family — email us, or find us on our channels.`}
>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <h1 class="text-display-md text-ink sm:text-display-lg">Say hello</h1>
    <p class="mt-6 text-lg text-body">
      There's no form here and no ticket number — just us, reading our own
      inbox. Write whenever you like. We answer as a family, usually within a
      few days, sometimes slower when the mountain is busy.
    </p>

    <div
      class="accent-edge mt-10 rounded-xl bg-surface-card py-8 pl-8 pr-6 sm:pl-10"
    >
      <h2 class="font-sans text-xs font-medium uppercase tracking-[0.12em] text-muted">
        Email
      </h2>
      <a
        href={mailto}
        class="mt-3 block break-words font-serif text-display-sm text-primary hover:text-primary-active"
      >
        {CONTACT.email}
      </a>
      <div class="mt-6">
        <a href={mailto} class="btn btn-primary">Write to us</a>
      </div>
    </div>

    <h2 class="mt-16 text-display-sm text-ink">Good reasons to write</h2>
    <dl class="mt-8 grid gap-8 sm:grid-cols-2">
      {
        REASONS.map((reason) => (
          <div>
            <dt class="font-serif text-lg font-medium text-ink">
              {reason.heading}
            </dt>
            <dd class="mt-2 text-body">{reason.text}</dd>
          </div>
        ))
      }
    </dl>

    <h2 class="mt-16 text-display-sm text-ink">Find us on our channels</h2>
    <p class="mt-4 text-body">
      New stories land here first. If you'd rather reply in public than in an
      inbox, this is the place.
    </p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        SOCIAL_CHANNELS.map((channel) => (
          <li>
            <a
              href={channel.href}
              target="_blank"
              rel="noopener noreferrer"
              class="card-lift flex h-full flex-col rounded-lg border border-hairline bg-surface-soft p-5"
            >
              <span class="font-serif text-lg font-medium text-ink">
                {channel.label}
              </span>
              <span class="mt-2 text-sm text-muted">
                {CHANNEL_NOTES[channel.label]}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-16 border-t border-hairline pt-8 text-sm text-muted">
      {SITE.name} is a personal family blog, so please keep anything sensitive
      out of your message. What happens to an email once it reaches us is
      covered in our <a href="/privacy" class="text-primary underline underline-offset-2">Privacy Policy</a>,
      and what you may do with our stories is covered in our{" "}
      <a href="/terms" class="text-primary underline underline-offset-2">Terms &amp; Conditions</a>.
    </p>
  </section>
</BaseLayout>
