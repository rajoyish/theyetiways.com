---
import CategoryView from "../../components/views/CategoryView.astro";
import { CATEGORIES } from "../../lib/site";
import { DEFAULT_LOCALE, categorySlugFor } from "../../lib/i18n";

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: categorySlugFor(category, DEFAULT_LOCALE) },
    props: { category },
  }));
}

const { category } = Astro.props;
---

<CategoryView category={category} />
