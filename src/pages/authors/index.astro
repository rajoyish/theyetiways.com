---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getFamily, getPostsByAuthor } from "../../lib/posts";

const family = await getFamily();
const members = await Promise.all(
  family.map(async (author) => ({
    author,
    count: (await getPostsByAuthor(author.id)).length,
  })),
);

const accentDot: Record<string, string> = {
  coral: "bg-primary",
  teal: "bg-accent-teal",
  amber: "bg-accent-amber",
};
---

<BaseLayout
  title="The Yeti Family"
  description="Papa, Mama, Babu, and Nanu Yeti — the four voices behind The Yeti Ways."
>
  <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <header class="max-w-2xl">
      <h1 class="text-display-md text-ink sm:text-display-lg">The Yeti Family</h1>
      <p class="mt-4 text-lg text-body-strong">
        Four of us. One cave. We write about the same days from different
        heights — because a lesson learned by the whole family is the one that
        actually sticks.
      </p>
    </header>

    <div class="mt-14 space-y-6">
      {
        members.map(({ author, count }) => (
          <article class="flex flex-col gap-6 rounded-lg bg-surface-card p-8 sm:flex-row sm:items-start">
            <Image
              src={author.data.avatar}
              alt={author.data.name}
              width={112}
              height={112}
              class="size-28 shrink-0 rounded-full object-cover"
            />
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span
                  class:list={[
                    "inline-block size-2 rounded-full",
                    accentDot[author.data.accent] ?? "bg-primary",
                  ]}
                />
                <h2 class="font-serif text-2xl text-ink">
                  <a href={`/authors/${author.id}`} class="hover:text-primary">
                    {author.data.name}
                  </a>
                </h2>
              </div>
              {author.data.nepaliNote && (
                <p class="mt-1 text-sm italic text-muted">{author.data.nepaliNote}</p>
              )}
              <p class="mt-3 text-body">{author.data.bio}</p>
              <p class="mt-4 text-sm text-muted">
                <a
                  href={`/authors/${author.id}`}
                  class="font-medium text-primary underline underline-offset-2"
                >
                  {count} {count === 1 ? "story" : "stories"}
                </a>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="py-16 sm:py-24">
    <CtaBand />
  </div>
</BaseLayout>
