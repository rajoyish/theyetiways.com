---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostGrid from "../../components/PostGrid.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getFamily, getPostsByAuthor } from "../../lib/posts";
import { SITE } from "../../lib/site";
import { profilePageSchema } from "../../lib/seo";

export async function getStaticPaths() {
  const family = await getFamily();
  return family.map((author) => ({
    params: { id: author.id },
    props: { author },
  }));
}

const { author } = Astro.props;
const posts = await getPostsByAuthor(author.id);

const site = Astro.site ?? new URL(SITE.url);
const profileSchema = profilePageSchema({
  name: author.data.name,
  description: author.data.bio,
  url: new URL(`/authors/${author.id}/`, site),
  sameAs: (author.data.socials ?? []).map((social) => social.href),
});

const accentDot: Record<string, string> = {
  coral: "bg-primary",
  teal: "bg-accent-teal",
  amber: "bg-accent-amber",
};
---

<BaseLayout
  title={author.data.name}
  description={`${author.data.name} on The Yeti Ways — ${author.data.tagline}`}
  jsonLd={[profileSchema]}
>
  <section class="border-b border-hairline">
    <div class="mx-auto flex max-w-4xl flex-col gap-8 px-6 py-16 sm:flex-row sm:items-center sm:py-20">
      <Image
        src={author.data.avatar}
        alt={author.data.name}
        width={140}
        height={140}
        class="size-32 shrink-0 rounded-full object-cover sm:size-36"
      />
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span
            class:list={[
              "inline-block size-2 rounded-full",
              accentDot[author.data.accent] ?? "bg-primary",
            ]}
          />
          <h1 class="text-display-md text-ink">{author.data.name}</h1>
        </div>
        {author.data.nepaliNote && (
          <p class="mt-1 text-sm italic text-muted">{author.data.nepaliNote}</p>
        )}
        <p class="mt-4 max-w-xl text-lg text-body-strong">{author.data.bio}</p>
        {
          author.data.socials && author.data.socials.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-3">
              {author.data.socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-primary underline underline-offset-2"
                >
                  {social.label}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <h2 class="mb-8 text-display-sm">
      Stories from {author.data.name}
    </h2>
    <PostGrid
      posts={posts}
      headingLevel="h3"
      emptyMessage={`${author.data.name} hasn't shared a story yet — soon. ❄️`}
    />
  </div>

  <div class="pb-16 sm:pb-24">
    <CtaBand />
  </div>
</BaseLayout>
