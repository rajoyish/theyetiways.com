---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import PostGrid from "../components/PostGrid.astro";
import AuthorBadge from "../components/AuthorBadge.astro";
import CtaBand from "../components/CtaBand.astro";
import { CATEGORIES, categorySlug, SITE } from "../lib/site";
import {
  getPublishedPosts,
  getFeaturedPost,
  getFamily,
} from "../lib/posts";

const posts = await getPublishedPosts();
const featured = await getFeaturedPost();
const latest = posts.filter((p) => p.id !== featured?.id).slice(0, 6);
const family = await getFamily();
---

<BaseLayout title={SITE.name} description={SITE.description}>
  {featured && <HeroSection post={featured} />}

  <section class="bg-surface-soft">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-display-sm">Latest stories</h2>
        <a href="/blog" class="text-sm font-medium text-primary underline underline-offset-2">
          All stories
        </a>
      </div>
      <PostGrid posts={latest} />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <h2 class="text-display-sm">Meet the family</h2>
    <p class="mt-3 max-w-2xl text-body">
      Every story here has more than one teller — the grown-ups and the kid who
      lived the same day from a different height. Same fireplace, different
      footprints in the snow.
    </p>
    <div class="mt-10 grid gap-8 sm:grid-cols-3">
      {family.map((author) => (
        <div class="card-lift rounded-xl bg-surface-card p-8">
          <AuthorBadge authors={[author]} variant="stacked" size={96} />
        </div>
      ))}
    </div>
  </section>

  <section class="bg-surface-dark text-on-dark">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
      <h2 class="text-display-sm text-on-dark">Find your trail</h2>
      <p class="mt-3 max-w-2xl text-on-dark-soft">
        Browse by what you're navigating right now.
      </p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          CATEGORIES.map((category, i) => (
            <a
              href={`/categories/${categorySlug(category)}`}
              class="accent-edge group flex items-center justify-between rounded-lg bg-surface-dark-elevated px-6 py-5 pl-7 text-on-dark transition-colors hover:bg-surface-dark-soft"
              style={`--accent-edge-color:${["#2a84d3", "#f06baa", "#6bcdb2"][i % 3]}`}
            >
              <span class="font-serif text-xl">{category}</span>
              <svg class="transition-transform group-hover:translate-x-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="py-16 sm:py-24">
    <CtaBand />
  </div>
</BaseLayout>
