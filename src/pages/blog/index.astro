---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryTabs from "../../components/CategoryTabs.astro";
import PostGrid from "../../components/PostGrid.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Stories"
  description="Every story from The Yeti Ways — warm, honest notes on family, relationships, parenting, and growing up, each one built around a video."
>
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <header class="max-w-2xl">
      <h1 class="text-display-md text-ink sm:text-display-lg">Stories</h1>
      <p class="mt-4 text-lg text-body-strong">
        Warm, honest notes on family, relationships, parenting, and growing up —
        each one built around a video from our channels.
      </p>
    </header>

    <div class="mt-10 border-y border-hairline py-4">
      <CategoryTabs active="all" />
    </div>

    <div class="mt-12">
      <PostGrid posts={posts} />
    </div>
  </div>
</BaseLayout>
