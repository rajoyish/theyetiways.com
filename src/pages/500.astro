---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  error?: unknown;
}
---

<BaseLayout title="Server Error" description="Something went wrong on our end." noindex={true}>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-6 py-24 sm:py-32 text-center">
    <div class="flex size-24 items-center justify-center rounded-3xl bg-surface-card shadow-[var(--shadow-lift)] ring-1 ring-hairline">
      <p class="text-5xl" aria-hidden="true">🌨️</p>
    </div>
    <h1 class="mt-8 text-display-md text-ink sm:text-display-lg">Caught in a snowstorm</h1>
    <p class="mt-4 max-w-lg text-lg text-body">
      Something broke on our end. We're weathering the storm and working to get the trail cleared.
      Please try again in a little while.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/contact" class="btn btn-secondary">Let us know</a>
    </div>
  </section>
</BaseLayout>
