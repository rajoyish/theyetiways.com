---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTabs from "./CategoryTabs.astro";
import PostGrid from "./PostGrid.astro";
import Pagination from "./Pagination.astro";
import { paginate } from "../lib/pagination";
import type { Post } from "../lib/posts";
import {
  fill,
  getLangFromUrl,
  localizePath,
  useTranslations,
} from "../lib/i18n";

interface Props {
  posts: Post[];
  page: number;
}
const { posts, page } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { items, current, total } = paginate(posts, page);
const suffix =
  current > 1 ? ` ${fill(t.stories.pageSuffix, { current, total })}` : "";
const basePath = localizePath("/blog", lang);
---

<BaseLayout
  title={`${t.stories.title}${suffix}`}
  description={current > 1 ? `${t.stories.description}${suffix}` : t.stories.description}
>
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <header class="max-w-2xl">
      <h1 class="text-display-md text-ink sm:text-display-lg">{t.stories.title}</h1>
      <p class="mt-4 text-lg text-body-strong">{t.stories.intro}</p>
    </header>

    <div class="mt-10 border-y border-hairline py-4">
      <CategoryTabs active="all" />
    </div>

    <div class="mt-12">
      <PostGrid posts={items} />
    </div>

    <Pagination
      current={current}
      total={total}
      basePath={basePath}
      class="mt-12 border-t border-hairline pt-6"
    />
  </div>
</BaseLayout>
