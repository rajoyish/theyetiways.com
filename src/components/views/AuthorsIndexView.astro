---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../CtaBand.astro";
import {
  authorPath,
  authorText,
  getFamily,
  getPostsByAuthor,
} from "../../lib/posts";
import { getLangFromUrl, storyCount, useTranslations } from "../../lib/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const family = await getFamily();
const members = await Promise.all(
  family.map(async (author) => ({
    author,
    text: authorText(author, lang),
    count: (await getPostsByAuthor(author.id, lang)).length,
  })),
);

const accentDot: Record<string, string> = {
  blue: "bg-blue",
  pink: "bg-accent-pink",
  mint: "bg-accent-mint",
};

const accentEdge: Record<string, string> = {
  blue: "#2a84d3",
  pink: "#f06baa",
  mint: "#6bcdb2",
};
---

<BaseLayout title={t.authors.title} description={t.authors.description}>
  <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <header class="max-w-2xl">
      <h1 class="text-display-md text-ink sm:text-display-lg">{t.authors.title}</h1>
      <p class="mt-4 text-lg text-body-strong">{t.authors.intro}</p>
    </header>

    <div class="mt-14 space-y-6">
      {
        members.map(({ author, text, count }) => (
          <article
            class="accent-edge flex flex-col gap-6 rounded-lg bg-surface-card p-8 pl-9 sm:flex-row sm:items-start"
            style={`--accent-edge-color:${accentEdge[author.data.accent] ?? "#2a84d3"}`}
          >
            <Image
              src={author.data.avatar}
              alt={author.data.name}
              width={112}
              height={112}
              class="size-28 shrink-0 rounded-full object-cover ring-4 ring-canvas"
            />
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span
                  class:list={[
                    "inline-block size-2 rounded-full",
                    accentDot[author.data.accent] ?? "bg-primary",
                  ]}
                />
                <h2 class="font-serif text-2xl text-ink">
                  <a href={authorPath(author.id, lang)} class="hover:text-primary">
                    {author.data.name}
                  </a>
                </h2>
              </div>
              {text.nepaliNote && (
                <p class="mt-1 text-sm italic text-muted">{text.nepaliNote}</p>
              )}
              <p class="mt-3 text-body">{text.bio}</p>
              <p class="mt-4 text-sm text-muted">
                <a
                  href={authorPath(author.id, lang)}
                  class="font-medium text-primary underline underline-offset-2"
                >
                  {count} {storyCount(count, lang)}
                </a>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="py-16 sm:py-24">
    <CtaBand />
  </div>
</BaseLayout>
