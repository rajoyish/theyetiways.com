---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostGrid from "../PostGrid.astro";
import { getPostsByTag, getTagTranslations, tagSlug } from "../../lib/posts";
import {
  fill,
  getLangFromUrl,
  localeAlternates,
  localizePath,
  storyCount,
  useTranslations,
} from "../../lib/i18n";

interface Props {
  /** The tag as written in frontmatter, e.g. `hugs` or `kleine gesten`. */
  tag: string;
}
const { tag } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await getPostsByTag(tag, lang);

/* A tag has no shared key across locales, so its pairs are inferred from the
   translated posts that carry it. Locales with no match get no alternate. */
const translations = await getTagTranslations(tag, lang);
const alternates = localeAlternates((code) => {
  const sibling = translations[code];
  return sibling ? `/tags/${tagSlug(sibling)}` : undefined;
});

const title = fill(t.tag.title, { tag });
const description = fill(t.tag.description, { tag });
---

<BaseLayout title={title} description={description} alternates={alternates}>
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <header class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted">
        {t.tag.eyebrow}
      </p>
      <h1 class="mt-3 text-display-md text-ink sm:text-display-lg">#{tag}</h1>
      <p class="mt-4 text-lg text-body-strong">
        {posts.length} {storyCount(posts.length, lang)}
      </p>
    </header>

    <div class="mt-10 border-y border-hairline py-4">
      <a
        href={localizePath("/blog", lang)}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-ink"
      >
        <span aria-hidden="true">&larr;</span>
        {t.common.allStories}
      </a>
    </div>

    <div class="mt-12">
      <PostGrid posts={posts} />
    </div>
  </div>
</BaseLayout>
