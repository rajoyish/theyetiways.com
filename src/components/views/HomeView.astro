---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../HeroSection.astro";
import PostGrid from "../PostGrid.astro";
import AuthorBadge from "../AuthorBadge.astro";
import CtaBand from "../CtaBand.astro";
import { CATEGORIES, SITE } from "../../lib/site";
import { getPublishedPosts, getFeaturedPost, getFamily } from "../../lib/posts";
import {
  categoryLabel,
  categoryPath,
  getLangFromUrl,
  localizePath,
  useTranslations,
} from "../../lib/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getPublishedPosts(lang);
const featured = await getFeaturedPost(lang);
const latest = posts.filter((p) => p.id !== featured?.id).slice(0, 6);
const family = await getFamily();

/** The three family accents, cycled across the category cards. */
const ACCENTS = ["#2a84d3", "#f06baa", "#6bcdb2"];
---

<BaseLayout title={SITE.name} description={t.meta.description}>
  {featured && <HeroSection post={featured} />}

  <section class="bg-surface-soft">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-display-sm">{t.home.latestStories}</h2>
        <a
          href={localizePath("/blog", lang)}
          class="text-sm font-medium text-primary active:underline hover:underline hover:underline-offset-2"
        >
          {t.common.allStories}
        </a>
      </div>
      <PostGrid posts={latest} />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <h2 class="text-display-sm">{t.common.meetTheFamily}</h2>
    <p class="mt-3 max-w-2xl text-body">{t.home.meetTheFamilyIntro}</p>
    <div class="mt-10 grid gap-8 sm:grid-cols-3">
      {family.map((author) => (
        <div class="card-lift rounded-xl bg-surface-card p-8">
          <AuthorBadge authors={[author]} variant="stacked" size={96} />
        </div>
      ))}
    </div>
  </section>

  <section class="bg-surface-dark text-on-dark">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
      <h2 class="text-display-sm text-on-dark">{t.home.findYourTrail}</h2>
      <p class="mt-3 max-w-2xl text-on-dark-soft">{t.home.findYourTrailIntro}</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          CATEGORIES.map((category, i) => (
            <a
              href={categoryPath(category, lang)}
              class="accent-edge group flex items-center justify-between rounded-lg bg-surface-dark-elevated px-6 py-5 pl-7 text-on-dark transition-colors hover:bg-surface-dark-soft"
              style={`--accent-edge-color:${ACCENTS[i % 3]}`}
            >
              <span class="font-serif text-xl">{categoryLabel(category, lang)}</span>
              <svg class="transition-transform group-hover:translate-x-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="py-16 sm:py-24">
    <CtaBand />
  </div>
</BaseLayout>
