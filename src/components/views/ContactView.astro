---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT, SITE, SOCIAL_CHANNELS } from "../../lib/site";
import {
  fill,
  getLangFromUrl,
  localizePath,
  useTranslations,
} from "../../lib/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const mailto = `mailto:${CONTACT.email}`;

/* The closing note carries two inline links, so it is stored as one HTML
   string per locale rather than being stitched together from fragments —
   clause order around a link is not the same in every language. */
const disclaimer = fill(t.contact.disclaimer, {
  site: SITE.name,
  privacy: localizePath("/privacy", lang),
  terms: localizePath("/terms", lang),
});
---

<BaseLayout title={t.contact.title} description={t.contact.description}>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <h1 class="text-display-md text-ink sm:text-display-lg">{t.contact.heading}</h1>
    <p class="mt-6 text-lg text-body">{t.contact.intro}</p>

    <div class="accent-edge mt-10 rounded-xl bg-surface-card py-8 pl-8 pr-6 sm:pl-10">
      <h2 class="font-sans text-xs font-medium uppercase tracking-[0.12em] text-muted">
        {t.contact.emailLabel}
      </h2>
      <a
        href={mailto}
        class="mt-3 block break-words font-serif text-display-sm text-primary hover:text-primary-active"
      >
        {CONTACT.email}
      </a>
      <div class="mt-6">
        <a href={mailto} class="btn btn-primary">{t.contact.writeToUs}</a>
      </div>
    </div>

    <h2 class="mt-16 text-display-sm text-ink">{t.contact.reasonsHeading}</h2>
    <dl class="mt-8 grid gap-8 sm:grid-cols-2">
      {
        t.contact.reasons.map((reason) => (
          <div>
            <dt class="font-serif text-lg font-medium text-ink">{reason.heading}</dt>
            <dd class="mt-2 text-body">{reason.text}</dd>
          </div>
        ))
      }
    </dl>

    <h2 class="mt-16 text-display-sm text-ink">{t.contact.channelsHeading}</h2>
    <p class="mt-4 text-body">{t.contact.channelsIntro}</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        SOCIAL_CHANNELS.map((channel) => (
          <li>
            <a
              href={channel.href}
              target="_blank"
              rel="noopener noreferrer"
              class="card-lift flex h-full flex-col rounded-lg border border-hairline bg-surface-soft p-5"
            >
              <span class="font-serif text-lg font-medium text-ink">
                {channel.label}
              </span>
              <span class="mt-2 text-sm text-muted">
                {t.contact.channelNotes[channel.label]}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p
      class="contact-note mt-16 border-t border-hairline pt-8 text-sm text-muted"
      set:html={disclaimer}
    />
  </section>
</BaseLayout>

<style>
  .contact-note :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
