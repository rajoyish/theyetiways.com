---
import YetiMark from "./YetiMark.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { SITE } from "../lib/site";
import { navLinks } from "../lib/nav";
import {
  getLangFromUrl,
  localizePath,
  stripLocale,
  useTranslations,
  type Locale,
} from "../lib/i18n";

interface Props {
  /** hreflang targets for this page, forwarded to the language picker. */
  alternates?: Partial<Record<Locale, string>>;
}
const { alternates } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const links = navLinks(lang);

/**
 * Active state is decided on the locale-neutral path, so /es/blog marks
 * "Historias" exactly the way /blog marks "Stories". A link is active on its
 * own page and on anything nested under it, so a story keeps "Stories" marked.
 * Matching on a segment boundary rather than a bare prefix keeps /blog from
 * claiming a hypothetical /blogroll.
 */
const path = stripLocale(Astro.url.pathname);
const isActive = (target: string) =>
  target === "/"
    ? path === "/"
    : path === target || path.startsWith(`${target}/`);

const linkClass = (target: string) =>
  isActive(target)
    ? "bg-surface-card text-ink"
    : "text-muted hover:bg-surface-soft hover:text-ink";

const home = localizePath("/", lang);
const blog = localizePath("/blog", lang);
const search = localizePath("/search", lang);
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href={home} class="flex items-center gap-2 text-ink">
      <YetiMark size={26} class="text-primary" />
      <span class="font-serif text-xl font-medium tracking-tight">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={t.common.primaryNav}>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.path!) ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-2 text-sm font-medium transition-colors",
              linkClass(link.path!),
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href={blog} class="btn btn-primary hidden lg:inline-flex">
        {t.common.readStories}
      </a>
      <LanguagePicker alternates={alternates} class="hidden sm:block" />
      <a
        href={search}
        class:list={[
          "btn btn-secondary hidden size-10 !p-0 sm:inline-flex",
          isActive("/search") && "border-primary text-primary",
        ]}
        aria-current={isActive("/search") ? "page" : undefined}
        aria-label={t.common.searchStories}
        title={t.common.searchHint}
      >
        <svg
          width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.6-3.6" />
        </svg>
      </a>
      <button
        type="button"
        id="theme-toggle"
        class="btn btn-secondary size-10 !p-0"
        aria-label={t.common.toggleTheme}
      >
        <svg
          class="icon-moon"
          width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
          stroke-linejoin="round" aria-hidden="true"
        >
          <path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" />
        </svg>
        <svg
          class="icon-sun"
          width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
          stroke-linejoin="round" aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2M12 19.5v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2.5 12h2M19.5 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
      </button>
      <button
        type="button"
        id="menu-toggle"
        class="btn btn-secondary size-10 !p-0 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.common.openMenu}
        data-label-open={t.common.openMenu}
        data-label-close={t.common.closeMenu}
      >
        <svg
          id="menu-icon-open"
          width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          id="menu-icon-close"
          hidden
          width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

</header>

<div
  id="mobile-menu"
  hidden
  class="fixed inset-x-0 bottom-0 top-16 z-40 overflow-y-auto bg-canvas px-6 py-8 md:hidden"
>
  <nav class="flex flex-col gap-1" aria-label={t.common.mobileNav}>
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.path!) ? "page" : undefined}
          class:list={[
            "rounded-md px-3 py-3 text-lg font-medium transition-colors",
            isActive(link.path!)
              ? "bg-surface-card text-ink"
              : "text-body hover:bg-surface-soft hover:text-ink",
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={search}
      aria-current={isActive("/search") ? "page" : undefined}
      class:list={[
        "rounded-md px-3 py-3 text-lg font-medium transition-colors",
        isActive("/search")
          ? "bg-surface-card text-ink"
          : "text-body hover:bg-surface-soft hover:text-ink",
      ]}
    >
      {t.nav.search}
    </a>
    <a href={blog} class="btn btn-primary mt-4 self-start">{t.common.readStories}</a>

    <div class="mt-8 border-t border-hairline pt-6">
      <LanguagePicker alternates={alternates} variant="list" />
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  /** Everything behind the full-screen overlay, made inert while it's open. */
  const behind = () =>
    document.querySelectorAll<HTMLElement>("main, footer");

  let open = false;

  function setOpen(next: boolean, returnFocus = false) {
    if (!toggle || !menu || next === open) return;
    open = next;

    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    /* Both labels are rendered in the reader's language by the server. */
    const label = open
      ? toggle.dataset.labelClose
      : toggle.dataset.labelOpen;
    if (label) toggle.setAttribute("aria-label", label);
    if (iconOpen) iconOpen.hidden = open;
    if (iconClose) iconClose.hidden = !open;
    document.body.style.overflow = open ? "hidden" : "";
    behind().forEach((el) => el.toggleAttribute("inert", open));

    if (open) {
      menu.querySelector<HTMLAnchorElement>("a")?.focus();
    } else if (returnFocus) {
      toggle.focus();
    }
  }

  toggle?.addEventListener("click", () => setOpen(!open));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && open) setOpen(false, true);
  });

  /* Tapping a link closes the sheet, so a same-page anchor doesn't leave the
     overlay covering the destination. */
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setOpen(false);
  });

  /* Resizing past the md breakpoint hides the sheet via CSS. Without this the
     body would stay scroll-locked and the page content inert. */
  const desktop = window.matchMedia("(min-width: 48rem)");
  desktop.addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>

<script>
  /**
   * Two-state theme switch. The head script has already applied any saved
   * choice; this only reflects the *resolved* theme in aria-pressed and
   * flips it on click. With no saved choice we stay on the OS preference,
   * so the media query keeps steering and we follow it live.
   */
  const STORAGE_KEY = "yeti-theme";
  const root = document.documentElement;
  const toggle = document.getElementById("theme-toggle");
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");

  const resolved = () =>
    root.dataset.theme ?? (prefersDark.matches ? "dark" : "light");

  function sync() {
    toggle?.setAttribute("aria-pressed", String(resolved() === "dark"));
  }

  toggle?.addEventListener("click", () => {
    const next = resolved() === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch (error) {
      /* Storage blocked — the choice still holds for this page view. */
    }
    sync();
  });

  /* Only reaches the button while no explicit choice is stored, since
     data-theme takes precedence in resolved(). */
  prefersDark.addEventListener("change", sync);

  sync();
</script>

<script>
  /**
   * "/" jumps to search from anywhere on the site, the way most doc sites do.
   * On the search page itself the box is already there, so just focus it.
   * The jump target carries the current locale prefix, read off the <html>
   * element, so a Spanish reader stays in Spanish.
   */
  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;

    const target = event.target as HTMLElement | null;
    if (target?.isContentEditable || target?.closest("input, textarea, select")) return;

    event.preventDefault();
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    if (input) {
      input.focus();
      return;
    }
    const prefix = document.body.dataset.searchPath ?? "/search";
    window.location.assign(prefix);
  });
</script>
