---
import { formatDate, getLangFromUrl } from "../lib/i18n";

interface Props {
  date: Date;
  class?: string;
}
const { date, class: className } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const iso = date.toISOString();
const formatted = formatDate(date, lang);
---

<time datetime={iso} class={className}>{formatted}</time>
