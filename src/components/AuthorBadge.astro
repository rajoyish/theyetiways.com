---
import { Image } from "astro:assets";
import type { Author } from "../lib/posts";

/**
 * Renders one or more author avatars + names.
 * `inline`  — compact row for cards and post meta.
 * `stacked` — avatar above name/role, used on "Meet the Family".
 */
interface Props {
  authors: Author[];
  variant?: "inline" | "stacked";
  size?: number;
  class?: string;
}
const { authors, variant = "inline", size = 36, class: className } = Astro.props;

const accentDot: Record<string, string> = {
  blue: "bg-blue",
  pink: "bg-accent-pink",
  mint: "bg-accent-mint",
};
---

{
  variant === "inline" ? (
    <div class:list={["flex items-center gap-2.5", className]}>
      <div class="flex -space-x-2">
        {authors.map((author) => (
          <Image
            src={author.data.avatar}
            alt={author.data.name}
            width={size}
            height={size}
            class="rounded-full ring-2 ring-canvas object-cover"
            style={`width:${size}px;height:${size}px`}
          />
        ))}
      </div>
      <span class="text-sm text-muted">
        {authors.map((author, i) => (
          <>
            {i > 0 && <span> &amp; </span>}
            <a
              href={`/authors/${author.id}`}
              class="font-medium text-body-strong hover:text-primary"
            >
              {author.data.name}
            </a>
          </>
        ))}
      </span>
    </div>
  ) : (
    <div class:list={["flex flex-col items-center text-center gap-3", className]}>
      <Image
        src={authors[0].data.avatar}
        alt={authors[0].data.name}
        width={size}
        height={size}
        class="rounded-full object-cover"
        style={`width:${size}px;height:${size}px`}
      />
      <div>
        <div class="flex items-center justify-center gap-1.5">
          <span
            class:list={[
              "inline-block size-1.5 rounded-full",
              accentDot[authors[0].data.accent] ?? "bg-blue",
            ]}
          />
          <a
            href={`/authors/${authors[0].id}`}
            class="font-serif text-lg text-ink hover:text-primary"
          >
            {authors[0].data.name}
          </a>
        </div>
        <p class="mt-1 text-sm text-muted">{authors[0].data.tagline}</p>
      </div>
    </div>
  )
}
