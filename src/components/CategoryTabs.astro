---
import { CATEGORIES } from "../lib/site";
import {
  categoryLabel,
  categoryPath,
  getLangFromUrl,
  localizePath,
  useTranslations,
} from "../lib/i18n";

/** Link-based filter row — category-tab / category-tab-active from DESIGN.md. */
interface Props {
  /** The English category key, or "all" / "none". */
  active?: string;
  class?: string;
}
const { active, class: className } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tabs = [
  { label: t.common.all, href: localizePath("/blog", lang), key: "all" },
  ...CATEGORIES.map((category) => ({
    label: categoryLabel(category, lang),
    href: categoryPath(category, lang),
    key: category,
  })),
];
const activeKey = active ?? "all";
---

<nav
  class:list={["flex flex-wrap gap-1", className]}
  aria-label={t.common.categoriesNav}
>
  {
    tabs.map((tab) => {
      const isActive = tab.key === activeKey;
      return (
        <a
          href={tab.href}
          aria-current={isActive ? "page" : undefined}
          class:list={[
            "rounded-md px-3.5 py-2 text-sm font-medium transition-colors",
            isActive
              ? "bg-surface-card text-ink"
              : "text-muted hover:bg-surface-soft hover:text-ink",
          ]}
        >
          {tab.label}
        </a>
      );
    })
  }
</nav>
