---
import HeroMeshImage from "./HeroMeshImage.astro";
import type { Post } from "../lib/posts";
import type { ImageMetadata } from "astro";
import { youTubeEmbedUrl, youTubeWatchUrl } from "../lib/youtube";
import { fill, getLangFromUrl, useTranslations } from "../lib/i18n";

/**
 * Lightweight YouTube facade (DESIGN.md: dark product-surface card).
 * Renders only a poster + play button — no YouTube script or iframe, and
 * therefore no network request to youtube.com, until the visitor clicks play.
 * On click the inline script swaps in a privacy-friendly `youtube-nocookie`
 * iframe. Progressive enhancement: without JS the play button is a plain link
 * to watch on YouTube.
 *
 * The poster uses HeroMeshImage to display a dynamic mesh gradient background
 * derived from the video colors, with the portrait thumbnail contained and centered.
 */
interface Props {
  id: string;
  title: string;
  post?: Post;
  poster?: ImageMetadata;
  class?: string;
}
const { id, title, post, poster, class: className } = Astro.props;

const embedUrl = youTubeEmbedUrl(id);
const watchUrl = youTubeWatchUrl(id);
const t = useTranslations(getLangFromUrl(Astro.url));
const playLabel = fill(t.post.playVideo, { title });
---

<div
  class:list={[
    "yt-facade group relative aspect-[1200/630] overflow-hidden rounded-lg bg-surface-dark",
    className,
  ]}
  data-embed-url={embedUrl}
  data-title={title}
>
  <HeroMeshImage post={post} id={id} image={poster} title={title} class="size-full">
    <a
      class="yt-play absolute inset-0 flex items-center justify-center"
      href={watchUrl}
      aria-label={playLabel}
    >
      <span
        class="flex size-16 items-center justify-center rounded-full bg-primary text-on-primary shadow-sm transition-transform group-hover:scale-105 sm:size-20"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.79-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z" />
        </svg>
      </span>
    </a>
  </HeroMeshImage>
</div>

<script>
  class YetiYouTube {
    constructor(root: HTMLElement) {
      const play = root.querySelector<HTMLAnchorElement>(".yt-play");

      play?.addEventListener("click", (event) => {
        event.preventDefault();
        this.activate(root);
      });
    }

    activate(root: HTMLElement) {
      const src = root.dataset.embedUrl;
      const title = root.dataset.title ?? "YouTube video";
      if (!src) return;

      const iframe = document.createElement("iframe");
      iframe.src = src;
      iframe.title = title;
      iframe.loading = "lazy";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.setAttribute("allowfullscreen", "");
      iframe.className = "absolute inset-0 size-full border-0";

      root.replaceChildren(iframe);
      iframe.focus();
    }
  }

  document
    .querySelectorAll<HTMLElement>(".yt-facade")
    .forEach((el) => new YetiYouTube(el));
</script>
